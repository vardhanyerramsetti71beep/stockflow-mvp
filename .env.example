# Copy to your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Hosted Postgres connection string (required on Vercel, e.g. from Neon).
# Leave unset locally to use the embedded Postgres (PGlite) stored in ./data/pgdata.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
